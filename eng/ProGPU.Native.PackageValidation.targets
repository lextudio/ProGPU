<Project>
  <Target Name="ValidateProGpuNativePackageRuntimes"
          BeforeTargets="GenerateNuspec"
          Condition="'$(ProGpuNativeSkipRuntimeValidation)' != 'true'">
    <PropertyGroup>
      <_ProGpuFontRequiredArg Condition="'$(ProGpuNativeRequireFontHinting)' == 'true'">--require</_ProGpuFontRequiredArg>
      <ProGpuNativePython Condition="'$(ProGpuNativePython)' == '' and '$(OS)' == 'Windows_NT'">python</ProGpuNativePython>
      <ProGpuNativePython Condition="'$(ProGpuNativePython)' == ''">python3</ProGpuNativePython>
      <_ProGpuFontVerifier>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', 'progpu-verify-freetype.py'))</_ProGpuFontVerifier>
      <_ProGpuFontRuntimeRoot>$([MSBuild]::NormalizePath('$(ProGpuNativeRuntimeRoot)'))</_ProGpuFontRuntimeRoot>
      <_ProGpuEditWordRequiredArg Condition="'$(ProGpuNativeRequireEditWordIcu)' == 'true'">--require</_ProGpuEditWordRequiredArg>
      <!-- A closure that ships a subset of RIDs (e.g. win-x64 win-arm64 osx-arm64) names them here;
           otherwise each verifier requires every RID it knows once any one is staged. -->
      <_ProGpuNativeRidsArg Condition="'$(ProGpuNativePackageRids)' != ''">--rids $(ProGpuNativePackageRids)</_ProGpuNativeRidsArg>
      <_ProGpuEditWordVerifier>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', 'progpu-edit-word-icu-dependency.py'))</_ProGpuEditWordVerifier>
    </PropertyGroup>
    <ItemGroup>
      <_ProGpuFontAssets Include="$(ProGpuNativeRuntimeRoot)/runtimes/*/native/sdk/progpu-native-font-dependency.json;
                                 $(ProGpuNativeRuntimeRoot)/runtimes/*/native/sdk/*progpu_native_freetype*;
                                 $(ProGpuNativeRuntimeRoot)/runtimes/*/native/licenses/freetype/**/*" />
      <_ProGpuEditWordAssets Include="$(ProGpuNativeRuntimeRoot)/runtimes/*/native/sdk/progpu-native-edit-word-dependency.json;
                                     $(ProGpuNativeRuntimeRoot)/runtimes/*/native/sdk/*progpu_native_edit_icu*;
                                     $(ProGpuNativeRuntimeRoot)/runtimes/*/native/licenses/edit-word-icu/**/*" />
    </ItemGroup>
    <Exec Condition="'$(ProGpuNativeRequireFontHinting)' == 'true' or '@(_ProGpuFontAssets)' != ''"
          Command="&quot;$(ProGpuNativePython)&quot; &quot;$(_ProGpuFontVerifier)&quot; --package-root &quot;$(_ProGpuFontRuntimeRoot)&quot; $(_ProGpuFontRequiredArg) $(_ProGpuNativeRidsArg)" />
    <Exec Condition="'$(ProGpuNativeRequireEditWordIcu)' == 'true' or '@(_ProGpuEditWordAssets)' != ''"
          Command="&quot;$(ProGpuNativePython)&quot; &quot;$(_ProGpuEditWordVerifier)&quot; verify-package --package-root &quot;$(_ProGpuFontRuntimeRoot)&quot; $(_ProGpuEditWordRequiredArg) $(_ProGpuNativeRidsArg)" />
    <Error Condition="'$(ProGpuNativePackageWindowsOnly)' != 'true' And !Exists('$(ProGpuNativeRuntimeRoot)\runtimes\linux-x64\native\libprogpu_native.so') And ('$(ProGpuNativePackageRids)' == '' Or $([System.String]::Copy(' $(ProGpuNativePackageRids) ').Contains(' linux-x64 ')))"
           Text="The linux-x64 ProGPU native runtime has not been staged." />
    <Error Condition="'$(ProGpuNativePackageWindowsOnly)' != 'true' And !Exists('$(ProGpuNativeRuntimeRoot)\runtimes\linux-arm64\native\libprogpu_native.so') And ('$(ProGpuNativePackageRids)' == '' Or $([System.String]::Copy(' $(ProGpuNativePackageRids) ').Contains(' linux-arm64 ')))"
           Text="The linux-arm64 ProGPU native runtime has not been staged." />
    <Error Condition="'$(ProGpuNativePackageWindowsOnly)' != 'true' And !Exists('$(ProGpuNativeRuntimeRoot)\runtimes\osx-x64\native\libprogpu_native.dylib') And ('$(ProGpuNativePackageRids)' == '' Or $([System.String]::Copy(' $(ProGpuNativePackageRids) ').Contains(' osx-x64 ')))"
           Text="The osx-x64 ProGPU native runtime has not been staged." />
    <Error Condition="'$(ProGpuNativePackageWindowsOnly)' != 'true' And !Exists('$(ProGpuNativeRuntimeRoot)\runtimes\osx-arm64\native\libprogpu_native.dylib') And ('$(ProGpuNativePackageRids)' == '' Or $([System.String]::Copy(' $(ProGpuNativePackageRids) ').Contains(' osx-arm64 ')))"
           Text="The osx-arm64 ProGPU native runtime has not been staged." />
    <Error Condition="!Exists('$(ProGpuNativeRuntimeRoot)\runtimes\win-x64\native\progpu_native.dll') And ('$(ProGpuNativePackageRids)' == '' Or $([System.String]::Copy(' $(ProGpuNativePackageRids) ').Contains(' win-x64 ')))"
           Text="The win-x64 ProGPU native runtime has not been staged." />
    <Error Condition="!Exists('$(ProGpuNativeRuntimeRoot)\runtimes\win-arm64\native\progpu_native.dll') And ('$(ProGpuNativePackageRids)' == '' Or $([System.String]::Copy(' $(ProGpuNativePackageRids) ').Contains(' win-arm64 ')))"
           Text="The win-arm64 ProGPU native runtime has not been staged." />
    <Error Condition="'$(ProGpuNativePackageWindowsOnly)' != 'true' And !Exists('$(ProGpuNativeRuntimeRoot)\runtimes\linux-x64\native\libprogpu_native_dawn.so') And ('$(ProGpuNativePackageRids)' == '' Or $([System.String]::Copy(' $(ProGpuNativePackageRids) ').Contains(' linux-x64 ')))"
           Text="The linux-x64 ProGPU Dawn adapter has not been staged." />
    <Error Condition="'$(ProGpuNativePackageWindowsOnly)' != 'true' And !Exists('$(ProGpuNativeRuntimeRoot)\runtimes\linux-arm64\native\libprogpu_native_dawn.so') And ('$(ProGpuNativePackageRids)' == '' Or $([System.String]::Copy(' $(ProGpuNativePackageRids) ').Contains(' linux-arm64 ')))"
           Text="The linux-arm64 ProGPU Dawn adapter has not been staged." />
    <Error Condition="'$(ProGpuNativePackageWindowsOnly)' != 'true' And !Exists('$(ProGpuNativeRuntimeRoot)\runtimes\osx-x64\native\libprogpu_native_dawn.dylib') And ('$(ProGpuNativePackageRids)' == '' Or $([System.String]::Copy(' $(ProGpuNativePackageRids) ').Contains(' osx-x64 ')))"
           Text="The osx-x64 ProGPU Dawn adapter has not been staged." />
    <Error Condition="'$(ProGpuNativePackageWindowsOnly)' != 'true' And !Exists('$(ProGpuNativeRuntimeRoot)\runtimes\osx-arm64\native\libprogpu_native_dawn.dylib') And ('$(ProGpuNativePackageRids)' == '' Or $([System.String]::Copy(' $(ProGpuNativePackageRids) ').Contains(' osx-arm64 ')))"
           Text="The osx-arm64 ProGPU Dawn adapter has not been staged." />
    <Error Condition="!Exists('$(ProGpuNativeRuntimeRoot)\runtimes\win-x64\native\progpu_native_dawn.dll') And ('$(ProGpuNativePackageRids)' == '' Or $([System.String]::Copy(' $(ProGpuNativePackageRids) ').Contains(' win-x64 ')))"
           Text="The win-x64 ProGPU Dawn adapter has not been staged." />
    <Error Condition="!Exists('$(ProGpuNativeRuntimeRoot)\runtimes\win-arm64\native\progpu_native_dawn.dll') And ('$(ProGpuNativePackageRids)' == '' Or $([System.String]::Copy(' $(ProGpuNativePackageRids) ').Contains(' win-arm64 ')))"
           Text="The win-arm64 ProGPU Dawn adapter has not been staged." />
    <Error Condition="!Exists('$(ProGpuNativeRuntimeRoot)\runtimes\win-x64\native\progpu_native_direct2d.dll') And ('$(ProGpuNativePackageRids)' == '' Or $([System.String]::Copy(' $(ProGpuNativePackageRids) ').Contains(' win-x64 ')))"
           Text="The win-x64 ProGPU Direct2D COM provider has not been staged." />
    <Error Condition="!Exists('$(ProGpuNativeRuntimeRoot)\runtimes\win-arm64\native\progpu_native_direct2d.dll') And ('$(ProGpuNativePackageRids)' == '' Or $([System.String]::Copy(' $(ProGpuNativePackageRids) ').Contains(' win-arm64 ')))"
           Text="The win-arm64 ProGPU Direct2D COM provider has not been staged." />
  </Target>
</Project>
