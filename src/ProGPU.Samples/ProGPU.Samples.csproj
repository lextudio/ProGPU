<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ProGPU.Backend\ProGPU.Backend.csproj" />
    <ProjectReference Include="..\ProGPU.Transpiler\ProGPU.Transpiler.csproj" />
    <ProjectReference Include="..\ProGPU.Vector\ProGPU.Vector.csproj" />
    <ProjectReference Include="..\ProGPU.Text\ProGPU.Text.csproj" />
    <ProjectReference Include="..\ProGPU.Compute\ProGPU.Compute.csproj" />
    <ProjectReference Include="..\ProGPU.Scene\ProGPU.Scene.csproj" />
    <ProjectReference Include="..\ProGPU.Layout\ProGPU.Layout.csproj" />
    <ProjectReference Include="..\ProGPU.Virtualization\ProGPU.Virtualization.csproj" />
    <ProjectReference Include="..\ProGPU.Media.Editing\ProGPU.Media.Editing.csproj" />
    <ProjectReference Include="..\ProGPU.WinRT\ProGPU.WinRT.csproj" />
    <ProjectReference Include="..\ProGPU.WinUI\ProGPU.WinUI.csproj" />
    <ProjectReference Include="..\ProGPU.WinUI.Themes.Fluent\ProGPU.WinUI.Themes.Fluent.csproj" />
    <ProjectReference Include="..\ProGPU.WinUI.Charts\ProGPU.WinUI.Charts.csproj" />
    <ProjectReference Include="..\ProGPU.Dxf\ProGPU.Dxf.csproj" />
    <ProjectReference Include="..\ProGPU.Fonts.Inter\ProGPU.Fonts.Inter.csproj" />
    <ProjectReference Include="..\ProGPU.Fonts.Noto\ProGPU.Fonts.Noto.csproj" />
    <ProjectReference Include="..\SkiaSharp\SkiaSharp.csproj" />
    <ProjectReference Include="$(ProGpuDrawingProject)" />
    <ProjectReference Include="$(ProGpuPresentationCoreProject)" />
  </ItemGroup>

  <!-- This flag selects only this assembly's sample sources. Forwarding it to
       shared runtime projects creates a second build identity for the
       same output files when a mobile host also references those projects. -->
  <ItemGroup>
    <ProjectReference Update="@(ProjectReference)"
                      GlobalPropertiesToRemove="%(ProjectReference.GlobalPropertiesToRemove);ProGpuSamplesMobile" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Silk.NET.Input.Common" />
  </ItemGroup>


  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <ProGpuUseWindowsBaseShim>true</ProGpuUseWindowsBaseShim>
  </PropertyGroup>

  <PropertyGroup Condition="'$(ProGpuSamplesMobile)' == 'true'">
    <DefineConstants>$(DefineConstants);PROGPU_SAMPLES_MOBILE</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(ProGpuSamplesMobile)' == 'true'">
    <Compile Remove="Pages\MarkdownPage.cs" />
  </ItemGroup>
</Project>
