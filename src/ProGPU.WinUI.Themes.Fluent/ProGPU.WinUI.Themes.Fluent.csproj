<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>ProGPU.WinUI.Themes.Fluent</PackageId>
    <Description>Compiled WinUI Fluent theme resources for ProGPU.</Description>
    <PackageTags>ProGPU;WinUI;Fluent;Theme</PackageTags>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ProGPU.WinRT\ProGPU.WinRT.csproj" />
    <ProjectReference Include="..\ProGPU.WinUI\ProGPU.WinUI.csproj" />
    <None Include="..\..\external\microsoft-ui-xaml\src\dxaml\xcp\dxaml\themes\generic.xaml"
          Link="Themes\Generic.xaml" Pack="true"
          PackagePath="contentFiles\any\any\Themes\Generic.xaml" />
    <None Include="Microsoft-LICENSE.txt" Pack="true" PackagePath="licenses/Microsoft-Fluent-LICENSE.txt" />
  </ItemGroup>
</Project>
