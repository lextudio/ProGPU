<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0;net10.0-macos</TargetFrameworks>
    <!-- Restrict only this host's restore graph for portable builds without Apple
         workloads. Do not override TargetFrameworks globally: that would also
         retarget the netstandard2.0 XAML compiler/source-generator dependencies. -->
    <TargetFrameworks Condition="'$(ProGpuSamplesDesktopPortableOnly)' == 'true'">net10.0</TargetFrameworks>
    <ApplicationId Condition="'$(TargetFramework)' == 'net10.0-macos'">org.progpu.samples.desktop</ApplicationId>
    <ApplicationTitle Condition="'$(TargetFramework)' == 'net10.0-macos'">ProGPU Samples Desktop</ApplicationTitle>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ProGpuUseWindowsBaseShim>true</ProGpuUseWindowsBaseShim>
    <PublishAot>true</PublishAot>
    <EventSourceSupport>true</EventSourceSupport>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WebGPUSharp" />
    <ProjectReference Include="..\ProGPU.Samples\ProGPU.Samples.csproj" />
    <ProjectReference Include="..\ProGPU.Backend.Dawn\ProGPU.Backend.Dawn.csproj" />
    <ProjectReference Include="..\ProGPU.Backend.Native\ProGPU.Backend.Native.csproj" />
    <ProjectReference Include="..\ProGPU.Scene.Native\ProGPU.Scene.Native.csproj" />
    <ProjectReference Include="..\ProGPU.Apple.Media\ProGPU.Apple.Media.csproj"
                      Condition="'$(TargetFramework)' == 'net10.0-macos'" />
    <ProjectReference Include="..\ProGPU.Windows.Media\ProGPU.Windows.Media.csproj"
                      Condition="'$(TargetFramework)' == 'net10.0'" />
    <ProjectReference Include="..\ProGPU.Linux.Media\ProGPU.Linux.Media.csproj"
                      Condition="'$(TargetFramework)' == 'net10.0'" />
  </ItemGroup>

  <!-- The native CMake build remains independently reproducible. When it has
       been built locally, copy its stable C ABI library beside the sample so
       the native-renderer page is directly runnable. -->
  <ItemGroup>
    <None Include="..\..\artifacts\progpu-native\build\libprogpu_native.dylib"
          Link="libprogpu_native.dylib"
          CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('..\..\artifacts\progpu-native\build\libprogpu_native.dylib')" />
    <None Include="..\..\artifacts\progpu-native\build\libprogpu_native.so"
          Link="libprogpu_native.so"
          CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('..\..\artifacts\progpu-native\build\libprogpu_native.so')" />
    <None Include="..\..\artifacts\progpu-native\build\Release\progpu_native.dll"
          Link="progpu_native.dll"
          CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('..\..\artifacts\progpu-native\build\Release\progpu_native.dll')" />
  </ItemGroup>

  <!--
    The SDK's default executable-relative install name exceeds the reserved
    Mach-O load-command space in the packaged Intel Onigwrap library. Its
    shorter rpath identity uses the SDK's existing MonoBundle search path.
    Let the normal SDK task reidentify its private copy; never modify the
    original NuGet asset or skip library relocation/signing.
  -->
  <Target Name="ProGpuSetOnigwrapBundleIdentity"
          BeforeTargets="_ComputeDynamicLibrariesToReidentify"
          Condition="'$(TargetFramework)' == 'net10.0-macos'">
    <ItemGroup>
      <_FileNativeReference Update="@(_FileNativeReference)"
                            Condition="'%(_FileNativeReference.Filename)' == 'libonigwrap' And '%(_FileNativeReference.Extension)' == '.dylib' And '%(_FileNativeReference.Kind)' == 'Dynamic' And '%(_FileNativeReference.DynamicLibraryId)' == '' And '%(_FileNativeReference.ReidentifiedPath)' == ''">
        <DynamicLibraryId>@rpath/libonigwrap.dylib</DynamicLibraryId>
        <ProGpuOnigwrapBundleIdentity>true</ProGpuOnigwrapBundleIdentity>
      </_FileNativeReference>
    </ItemGroup>
  </Target>

  <!-- The SDK's timestamp check does not include DynamicLibraryId metadata.
       Invalidate only its owned copy when this project changes. Keep the SDK's
       common native directory: the native linker resolves -l names through its
       ordered search paths. Publish the stamp only after relocation succeeds. -->
  <Target Name="ProGpuInvalidateOnigwrapBundleIdentity"
          BeforeTargets="_InstallNameTool"
          DependsOnTargets="_ComputeDynamicLibrariesToReidentify"
          Inputs="$(MSBuildProjectFullPath)"
          Outputs="$(_IntermediateNativeLibraryDir)/progpu-onigwrap-rpath.stamp"
          Condition="'$(TargetFramework)' == 'net10.0-macos'">
    <ItemGroup>
      <_ProGpuOnigwrapToReidentify Include="@(_DynamicLibraryToReidentify)"
                                  Condition="'%(_DynamicLibraryToReidentify.ProGpuOnigwrapBundleIdentity)' == 'true'" />
    </ItemGroup>
    <Delete Files="@(_ProGpuOnigwrapToReidentify->'%(ReidentifiedPath)')" />
    <PropertyGroup>
      <_ProGpuOnigwrapIdentityInvalidated>true</_ProGpuOnigwrapIdentityInvalidated>
    </PropertyGroup>
  </Target>

  <Target Name="ProGpuRecordOnigwrapBundleIdentity"
          AfterTargets="_InstallNameTool"
          Condition="'$(_ProGpuOnigwrapIdentityInvalidated)' == 'true'">
    <WriteLinesToFile File="$(_IntermediateNativeLibraryDir)/progpu-onigwrap-rpath.stamp"
                      Lines="@rpath/libonigwrap.dylib" Overwrite="true" />
  </Target>

  <!--
    Package-provided macOS dylibs are already deployment binaries. Re-stripping
    them fails on Xcode 26 when their indirect symbol tables retain imports.
    Keep prebuilt dylibs intact while still stripping the NativeAOT executable.
  -->
  <Target Name="ProGpuPreservePrebuiltNativeSymbols"
          AfterTargets="_CollectItemsForPostProcessing"
          BeforeTargets="_PreparePostProcessing"
          Condition="'$(TargetFramework)' == 'net10.0-macos'">
    <ItemGroup>
      <_PostProcessingItem Update="@(_PostProcessingItem)"
                           Condition="'%(_PostProcessingItem.Extension)' == '.dylib'">
        <NoSymbolStrip>true</NoSymbolStrip>
      </_PostProcessingItem>
    </ItemGroup>
  </Target>
</Project>
